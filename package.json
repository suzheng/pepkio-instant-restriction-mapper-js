{
  "name": "pepkio-instant-restriction-mapper",
  "version": "0.1.0",
  "description": "Execute restriction endonuclease site scanning, topology-aware cleavage mapping, and virtual digest simulations using the Pepkio Tools REST API.",
  "readme": "README_NPM.md",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-instant-restriction-mapper": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_NPM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-instant-restriction-mapper-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-instant-restriction-mapper-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/instant-restriction-mapper",
  "keywords": [
    "instant-restriction-mapper",
    "restriction-mapper",
    "restriction-enzymes",
    "cloning",
    "plasmid",
    "molecular-biology",
    "rebase",
    "virtual-digest",
    "virtual-gel",
    "sticky-ends",
    "dna-sequence",
    "bioinformatics",
    "pepkio",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
